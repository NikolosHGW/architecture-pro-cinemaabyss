@startuml
!include <C4/C4_Container>

System_Boundary(cinemaabyss, "Кинобездна") {
    Container(clients, "Клиенты пользователя", "", "Веб, десктоп-приложение, Смарт-ТВ и мобильное приложение")
    Container(gateway, "API Gateway")
    Container(bffs, "Серверные BFF", "", "Отдельный BFF для каждого клиента: веба, десктопа, Смарт-ТВ и мобильного приложения")

    Container(auth, "Сервис пользователей (auth)")
    Container(movies, "Сервис метаданных о фильмах (movies)")
    Container(payments, "Сервис платежей (billing)", "", "Отвечает за платежи, подписки и скидки")
    Container(streaming, "Сервис стриминга", "", "Получает у партнёров адрес встроенного плеера для выбранного фильма")

    ContainerDb(auth_db, "База пользователей", "PostgreSQL")
    ContainerDb(movies_db, "База каталога", "PostgreSQL")
    ContainerDb(movies_images, "Хранилище изображений каталога", "S3", "Постеры, обложки и другие изображения фильмов")
    ContainerDb(payments_db, "База платежей", "PostgreSQL")
}

System_Ext(recommendation_system, "Рекомендательная система")
System_Ext(payment_system, "Платёжная система")
System_Ext(online_cinemas, "Онлайн-кинотеатры")

Rel_D(clients, gateway, "Отправляют запросы к API")
Rel_D(gateway, bffs, "Направляет запрос в BFF клиента")

Rel_D(bffs, auth, "Обращаются при входе пользователя")
Rel_D(bffs, movies, "Запрашивают каталог и метаданные фильмов")
Rel_D(bffs, payments, "Создают платежи и запрашивают их статус")
Rel_D(bffs, streaming, "Запрашивают адрес плеера")
Rel(streaming, payments, "Проверяет право пользователя на просмотр фильма", "HTTP/REST")

Rel_D(auth, auth_db, "Читает и сохраняет данные пользователей")
Rel_D(movies, movies_db, "Читает и сохраняет метаданные фильмов")
Rel_D(movies, movies_images, "Читает и сохраняет изображения фильмов")
Rel_D(payments, payments_db, "Читает и сохраняет данные платежей")

Rel_D(movies, recommendation_system, "Сервис Movies и Рек.система обменивается сообщениями", "RabbitMQ")
Rel_D(payments, payment_system, "Создаёт платёж", "HTTP")
Rel_U(payment_system, payments, "Уведомляет о результате оплаты", "HTTP webhook")
Rel_D(streaming, online_cinemas, "Запрашивает адрес встроенного плеера")

Rel(clients, online_cinemas, "Загружают видео во встроенном плеере")

note right of movies
    Если считается, что RabbitMQ находится во власти внешней системы
    рекомендаций, то при таком условии кажется, что Kafka тут выглядит
    пока что неуместно.

    Асинхронную работу мы можем продолжать делать через внешний RabbitMQ,
    при собирании событий просмотра и выставлении рейтинга пользователем,
    тут можем записывать эти данные в Postgresql и в таблицу outbox,
    а затем worker в этом же сервисе, будет вычитывать outbox и посылать
    события в rabbitmq внешней рекомендательной системы.

    Всё остальное не нуждается пока что в асинхронных взаимодействиях.
    Другое дело, если у нас в будущем появятся разные потребители этих
    события просмотров и рейтингов, то тут уже лучше внедрить Кафку,
    чтоб была удобная организация потребления этих данных разными
    потребителями и перечитывания истории, но в данной ситуации этого пока нет.
end note

@enduml
